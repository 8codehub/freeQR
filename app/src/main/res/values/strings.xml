    <string name="guide_contrast_title">Keep it clear</string>
    <string name="guide_contrast_body">Use dark modules on a light background. Our palettes keep strong contrast and a clear border around every QR.</string>
    <string name="guide_print_title">Print with confidence</string>
    <string name="guide_print_body">Try at least 2 × 2 cm for simple codes; dense codes need more space. SVG stays sharp at any size. Test at the intended size and distance.</string>
    <string name="guide_test_title">Try before you share</string>
    <string name="guide_test_body">Scan your exported QR on more than one device. Check the destination and test Wi-Fi or contact details before distributing it.</string>
    <string name="guide_privacy_title">Private by design</string>
    <string name="guide_privacy_body">QR generation happens on your device. This app has no analytics or network permission. Saved codes stay in app storage; uninstalling removes them. Export important codes first.</string>
    <string name="guide_static_title">No expiry. No surprises.</string>
    <string name="guide_static_body">QR codes are static and do not expire. A website must remain available for its QR link to work. Change the content by generating a new code.</string>
    <string name="guide_about_title">Easy QR Studio · 2.0</string>
    <string name="guide_about_body">Create, style, save, and export. All included. No account, subscription, or scan tracking. Shared QRs reveal their content to anyone who scans them, including Wi-Fi passwords.</string>
